# Meta Threads API (Long-lived token, 60 days)
INIT_THREADS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Safety: keep true first to preview replies without posting
DRY_RUN=true
AFFILIATE_MODE=off

# Optional Telegram alerts for medical escalations, errors, and dry-run drafts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pacing & anti-spam limits
POLL_INTERVAL_SEC=60
DELAY_MIN_SEC=60
DELAY_MAX_SEC=300
MAX_REPLIES_PER_HOUR=20
MAX_REPLIES_PER_DAY=100
